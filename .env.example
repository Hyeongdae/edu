# Microsoft Entra single-tenant SPA app registration values.
# Register http://localhost:5173 as a Single-page application redirect URI.
# For a browser-only local preview without Entra, set VITE_LOCAL_DEMO_MODE=true in .env.local.
# This bypass is enabled only by Vite's development server, never by a production build.
VITE_LOCAL_DEMO_MODE=false
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
